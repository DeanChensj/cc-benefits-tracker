{
  "manifest_version": 3,
  "name": "PerkFolio Assistant",
  "version": "1.0.2",
  "description": "Contextual perk reminders and card recommendations for PerkFolio.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://uber.com/*",
    "*://*.uber.com/*",
    "*://ubereats.com/*",
    "*://*.ubereats.com/*",
    "*://doordash.com/*",
    "*://*.doordash.com/*",
    "*://grubhub.com/*",
    "*://*.grubhub.com/*",
    "*://resy.com/*",
    "*://*.resy.com/*",
    "*://delta.com/*",
    "*://*.delta.com/*",
    "*://united.com/*",
    "*://*.united.com/*",
    "*://aa.com/*",
    "*://*.aa.com/*",
    "*://lyft.com/*",
    "*://*.lyft.com/*",
    "*://marriott.com/*",
    "*://*.marriott.com/*",
    "*://hyatt.com/*",
    "*://*.hyatt.com/*",
    "*://hilton.com/*",
    "*://*.hilton.com/*",
    "*://ihg.com/*",
    "*://*.ihg.com/*",
    "*://saksfifthavenue.com/*",
    "*://*.saksfifthavenue.com/*",
    "*://dell.com/*",
    "*://*.dell.com/*",
    "*://walmart.com/*",
    "*://*.walmart.com/*",
    "*://amazon.com/*",
    "*://*.amazon.com/*",
    "*://disneyplus.com/*",
    "*://*.disneyplus.com/*",
    "*://hulu.com/*",
    "*://*.hulu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://perkfolio.cc/*",
        "*://*.perkfolio.cc/*"
      ],
      "js": ["content_web.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://uber.com/*",
        "*://*.uber.com/*",
        "*://ubereats.com/*",
        "*://*.ubereats.com/*",
        "*://doordash.com/*",
        "*://*.doordash.com/*",
        "*://grubhub.com/*",
        "*://*.grubhub.com/*",
        "*://resy.com/*",
        "*://*.resy.com/*",
        "*://delta.com/*",
        "*://*.delta.com/*",
        "*://united.com/*",
        "*://*.united.com/*",
        "*://aa.com/*",
        "*://*.aa.com/*",
        "*://lyft.com/*",
        "*://*.lyft.com/*",
        "*://marriott.com/*",
        "*://*.marriott.com/*",
        "*://hyatt.com/*",
        "*://*.hyatt.com/*",
        "*://hilton.com/*",
        "*://*.hilton.com/*",
        "*://ihg.com/*",
        "*://*.ihg.com/*",
        "*://saksfifthavenue.com/*",
        "*://*.saksfifthavenue.com/*",
        "*://dell.com/*",
        "*://*.dell.com/*",
        "*://walmart.com/*",
        "*://*.walmart.com/*",
        "*://amazon.com/*",
        "*://*.amazon.com/*",
        "*://disneyplus.com/*",
        "*://*.disneyplus.com/*",
        "*://hulu.com/*",
        "*://*.hulu.com/*"
      ],
      "js": ["content_script.js"]
    }
  ]
}
